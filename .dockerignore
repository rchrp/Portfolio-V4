# Rebuilt inside the image
**/node_modules
**/.next
**/src/generated/prisma
**/*.tsbuildinfo
**/next-env.d.ts

# Secrets stay out of the build context: Dokploy injects them at runtime
**/.env
**/.env.*
!**/.env.example

# Not needed to build or run the site
.git
.idea
.vscode
.claude
artifacts
**/.impeccable
**/assets
**/*.log
**/.DS_Store
Dockerfile
.dockerignore
docker-compose.yml
