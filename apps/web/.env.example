# Copy this file to apps/web/.env (`pnpm dev` does it on the first run).
# This URL targets the database from docker-compose.yml. Leave it empty to
# display the explicitly labeled demonstration projects instead.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_v4"

# Exact origin the admin panel (/admin) is served from. Passkeys are bound to
# its host name: changing the domain means enrolling new passkeys. Defaults to
# http://localhost:3000 in development; the panel stays closed in production
# until it is set, e.g. ADMIN_ORIGIN="https://example.com".
ADMIN_ORIGIN=""
