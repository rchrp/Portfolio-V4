generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// The setting a project was made in, shown as its kicker.
enum ProjectKind {
  PRODUCT
  FREELANCE
  PERSONAL
  SCHOOL
}

enum ProjectLinkKind {
  WEBSITE
  SOURCE
  DOWNLOAD
  VIDEO
  COMMUNITY
}

model Project {
  id           String          @id @default(cuid())
  slug         String          @unique @db.VarChar(100)
  title        String          @db.VarChar(120)
  /// One sentence under the title.
  summary      String          @db.VarChar(320)
  description  String          @db.Text
  kind         ProjectKind
  /// What the project is, e.g. "Application desktop".
  category     String          @db.VarChar(80)
  role         String          @db.VarChar(120)
  client       String?         @db.VarChar(120)
  startedOn    DateTime        @db.Date
  /// Null while the project is still going on.
  endedOn      DateTime?       @db.Date
  /// Key points, one short sentence each.
  highlights   String[]        @default([])
  technologies String[]        @default([])
  imageUrl     String?         @db.VarChar(2048)
  imageAlt     String?         @db.VarChar(240)
  accentColor  String          @default("#f15a24") @db.VarChar(7)
  /// A caveat visitors should read first, e.g. a platform taken offline.
  notice       String?         @db.VarChar(400)
  featured     Boolean         @default(false)
  status       ProjectStatus   @default(DRAFT)
  sortOrder    Int             @default(0)
  publishedAt  DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  links        ProjectLink[]
  media        ProjectMedia[]
  metrics      ProjectMetric[]

  @@index([status, sortOrder, createdAt, id])
}

model ProjectLink {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ProjectLinkKind
  label     String          @db.VarChar(60)
  url       String          @db.VarChar(2048)
  sortOrder Int             @default(0)

  @@unique([projectId, url])
  @@index([projectId, sortOrder])
}

/// Screenshots shown in the project's gallery, after its cover.
model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(2048)
  alt       String  @db.VarChar(240)
  caption   String? @db.VarChar(160)
  sortOrder Int     @default(0)

  @@index([projectId, sortOrder])
}

/// A figure worth a glance, e.g. value "10 000", label "joueurs".
model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  value     String  @db.VarChar(24)
  label     String  @db.VarChar(80)
  sortOrder Int     @default(0)

  @@index([projectId, sortOrder])
}

// ─── Admin panel ─────────────────────────────────────────────────────────────
// A single administrator signs in with passkeys (WebAuthn). There is no
// password: the first passkey is enrolled through a one-time link printed by
// `pnpm admin:invite`, which needs shell access to the server.

/// A passkey allowed to sign in to the admin panel.
model AdminPasskey {
  /// Base64url credential ID, as sent by the authenticator.
  id         String         @id @db.VarChar(1024)
  publicKey  Bytes
  /// Signature counter, checked to detect cloned authenticators.
  counter    BigInt         @default(0)
  transports String[]       @default([])
  /// "singleDevice" or "multiDevice" (synced, e.g. by Bitwarden).
  deviceType String         @db.VarChar(16)
  backedUp   Boolean        @default(false)
  name       String         @db.VarChar(60)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime?      @db.Timestamptz(3)
  sessions   AdminSession[]
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is
/// stored, so a database leak does not leak live sessions.
model AdminSession {
  id         String       @id @db.Char(64)
  passkeyId  String
  passkey    AdminPasskey @relation(fields: [passkeyId], references: [id], onDelete: Cascade)
  userAgent  String?      @db.VarChar(255)
  ipAddress  String?      @db.VarChar(64)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime     @db.Timestamptz(3)

  @@index([passkeyId])
  @@index([expiresAt])
}

enum AdminChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

/// A WebAuthn challenge waiting for its answer. Single use, short lived.
model AdminChallenge {
  /// SHA-256 of the token kept in the browser's challenge cookie.
  id        String                @id @db.Char(64)
  purpose   AdminChallengePurpose
  challenge String                @db.VarChar(128)
  /// Registration only: the invite or the session that allowed it.
  inviteId  String?               @db.Char(64)
  sessionId String?               @db.Char(64)
  expiresAt DateTime              @db.Timestamptz(3)

  @@index([expiresAt])
}

/// A one-time link that lets a browser enroll a passkey.
model AdminInvite {
  /// SHA-256 of the token carried in the link's fragment.
  id        String    @id @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}

/// What happened in the admin panel, newest first on the security page.
model AdminAuditEvent {
  id        String   @id @default(cuid())
  action    String   @db.VarChar(40)
  detail    String?  @db.VarChar(240)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}
